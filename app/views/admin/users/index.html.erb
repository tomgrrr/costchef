<% content_for :title, "Administration" %>
<% subscribed = @users.count(&:subscription_active?) %>

<%= page_header("Administration",
                subtitle: "Les comptes traiteurs et leur abonnement. Visible par les administrateurs seulement.") do %>
  <%= link_to new_admin_invitation_path, class: "btn btn--primary" do %><%= icon("envelope") %> Inviter un traiteur<% end %>
<% end %>

<%= render "admin/tabs" %>

<div class="grid-auto" style="--grid-min: 180px">
  <div class="card kpi"><span class="kpi__label">Comptes</span><span class="kpi__value"><%= @users.size %></span></div>
  <div class="card kpi"><span class="kpi__label">Abonnements actifs</span><span class="kpi__value text-success"><%= subscribed %></span></div>
  <div class="card kpi"><span class="kpi__label">Sans abonnement</span><span class="kpi__value <%= "text-warning" if (@users.size - subscribed).positive? %>"><%= @users.size - subscribed %></span></div>
</div>

<section class="card" data-controller="dialog" aria-label="Comptes utilisateurs">
  <% if @users.empty? %>
    <%= empty_state("Aucun utilisateur enregistré", "Invitez un premier traiteur : il recevra un lien valable 7 jours.") %>
  <% else %>
    <div class="table-wrap">
      <table class="table" style="--table-min: 980px">
        <thead>
          <tr>
            <th scope="col">Compte</th>
            <th scope="col">Rôle</th>
            <th scope="col">Abonnement</th>
            <th scope="col">Début</th>
            <th scope="col">Expiration</th>
            <th scope="col">Notes</th>
            <th scope="col">Créé le</th>
            <th scope="col" class="table__actions"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td>
                <span class="cluster cluster--sm cluster--nowrap">
                  <span class="avatar avatar--lg avatar--muted" aria-hidden="true"><%= initials_for(user.company_name.presence || user.email) %></span>
                  <span class="stack stack--xs">
                    <span class="text-medium"><%= user.company_name.presence || user.email %></span>
                    <span class="text-body-sm text-muted"><%= user.email if user.company_name.present? %><%= " · vous" if user == current_user %></span>
                  </span>
                </span>
              </td>
              <td><%= user.admin? ? chip("Admin", tone: :brand) : chip("Traiteur") %></td>
              <td><%= user.subscription_active? ? chip("Actif", dot: :success) : chip("Inactif", dot: :warning, tone: :warning) %></td>
              <td class="num text-secondary"><%= user.subscription_started_at ? short_date(user.subscription_started_at.to_date) : "—" %></td>
              <td class="num text-secondary"><%= user.subscription_expires_at ? short_date(user.subscription_expires_at.to_date) : "—" %></td>
              <td class="text-body-sm text-secondary">
                <% if user.subscription_notes.present? %>
                  <span title="<%= user.subscription_notes %>"><%= truncate(user.subscription_notes, length: 40) %></span>
                <% else %>—<% end %>
              </td>
              <td class="num text-secondary"><%= short_date(user.created_at.to_date) %></td>
              <td class="table__actions">
                <% if user != current_user %>
                  <button type="button" class="btn btn--outline btn--sm" data-action="dialog#open"
                          data-dialog-id-param="modal-user-<%= user.id %>">Gérer</button>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% @users.each do |user| %>
      <% next if user == current_user %>
      <dialog class="dialog" id="modal-user-<%= user.id %>" aria-labelledby="modal-user-<%= user.id %>-label">
        <%= form_with(model: [:admin, user], method: :patch) do |f| %>
          <div class="dialog__header">
            <div class="stack stack--xs">
              <h2 class="card__title" id="modal-user-<%= user.id %>-label">Abonnement de <%= user.company_name.presence || user.email %></h2>
              <p class="text-body-sm text-muted"><%= user.email %></p>
            </div>
            <button type="button" class="icon-btn" data-action="dialog#close" aria-label="Fermer"><%= icon("x-lg") %></button>
          </div>
          <div class="dialog__body">
            <label class="switch-row" for="sub_active_<%= user.id %>">
              <span class="switch-row__text">Abonnement actif<span class="field__hint">Sans abonnement, le compte ne peut plus ouvrir l’application.</span></span>
              <%= f.check_box :subscription_active, class: "switch switch--success", role: "switch", id: "sub_active_#{user.id}" %>
            </label>
            <div class="form-row">
              <div class="field">
                <%= f.label :subscription_started_at, "Début", for: "sub_start_#{user.id}" %>
                <%= f.date_field :subscription_started_at, id: "sub_start_#{user.id}", class: "input",
                                 value: user.subscription_started_at&.strftime('%Y-%m-%d') %>
              </div>
              <div class="field">
                <%= f.label :subscription_expires_at, "Expiration", for: "sub_end_#{user.id}" %>
                <%= f.date_field :subscription_expires_at, id: "sub_end_#{user.id}", class: "input",
                                 value: user.subscription_expires_at&.strftime('%Y-%m-%d') %>
              </div>
            </div>
            <div class="field">
              <%= f.label :subscription_notes, "Notes internes", for: "sub_notes_#{user.id}" %>
              <%= f.text_area :subscription_notes, id: "sub_notes_#{user.id}", class: "input", rows: 3,
                              placeholder: "Visibles uniquement par les administrateurs" %>
            </div>
          </div>
          <div class="dialog__footer">
            <button type="button" class="btn btn--outline" data-action="dialog#close">Annuler</button>
            <%= f.button type: "submit", class: "btn btn--primary" do %>Enregistrer<% end %>
          </div>
        <% end %>
      </dialog>
    <% end %>
  <% end %>
</section>
