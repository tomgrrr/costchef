<% content_for :title, "Invitations" %>

<%= page_header("Administration",
                subtitle: "L’inscription se fait uniquement sur invitation. Le lien envoyé est valable 7 jours.") %>

<%= render "admin/tabs" %>

<section class="card card--pad stack stack--sm" aria-labelledby="invite-title">
  <h2 id="invite-title" class="card__title">Inviter un traiteur</h2>
  <%= render "admin/invitations/form", invitation: Invitation.new %>
</section>

<section class="card" aria-label="Invitations envoyées">
  <% if @invitations.empty? %>
    <%= empty_state("Aucune invitation pour le moment", "Les invitations envoyées apparaîtront ici avec leur statut.") %>
  <% else %>
    <div class="table-wrap">
      <table class="table" style="--table-min: 820px">
        <thead>
          <tr>
            <th scope="col">Email</th>
            <th scope="col">Statut</th>
            <th scope="col">Envoyée le</th>
            <th scope="col">Expire le</th>
            <th scope="col">Utilisée le</th>
            <th scope="col">Envoyée par</th>
          </tr>
        </thead>
        <tbody>
          <% @invitations.each do |invitation| %>
            <tr class="<%= "is-off" if invitation.status == :expired %>">
              <td class="text-medium"><%= invitation.email %></td>
              <% label, tone = { pending: ["En attente", :brand], used: ["Acceptée", :success], expired: ["Expirée", :off] }[invitation.status] %>
              <td><%= chip(label, dot: tone) if label %></td>
              <td class="num text-secondary"><%= short_date(invitation.created_at.to_date) %></td>
              <td class="num text-secondary"><%= short_date(invitation.expires_at.to_date) %></td>
              <td class="num text-secondary"><%= invitation.used_at ? short_date(invitation.used_at.to_date) : "—" %></td>
              <td class="text-secondary"><%= invitation.created_by_admin&.email || "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
