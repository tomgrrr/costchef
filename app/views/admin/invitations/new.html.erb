<% content_for :title, "Nouvelle invitation" %>
<% content_for :content_class, "app__content--narrow" %>

<%= breadcrumb(["Invitations", admin_invitations_path], "Nouvelle invitation") %>
<%= page_header("Inviter un traiteur",
                subtitle: "Un email d’invitation part automatiquement. Le lien est valable 7 jours.") %>

<section class="card card--pad stack stack--md">
  <% if @invitation.errors.any? %>
    <%= notice_box(tone: :danger, css: "notice--top") do %>
      <ul class="notice__list">
        <% @invitation.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    <% end %>
  <% end %>
  <%= render "admin/invitations/form", invitation: @invitation, autofocus: true %>
</section>
