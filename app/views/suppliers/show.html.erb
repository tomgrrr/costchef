<% content_for :title, @supplier.name %>
<% all_purchases = @comparison.flat_map { |row| row[:purchases] } %>
<% active_count = all_purchases.count(&:active?) %>
<% priced = @comparison.select { |row| row[:delta_pct] } %>
<% cheaper = priced.count { |row| row[:delta_pct] <= -0.5 } %>
<% dearer = priced.count { |row| row[:delta_pct] >= 0.5 } %>

<%= breadcrumb(["Fournisseurs", suppliers_path], @supplier.name) %>

<header class="page-header">
  <div class="page-header__text">
    <h1 class="text-display-lg"><%= @supplier.name %></h1>
    <div class="cluster cluster--xs">
      <%= @supplier.active? ? chip("Actif", dot: :success) : chip("Désactivé", dot: :off) %>
      <% if (last = all_purchases.max_by(&:created_at)) %>
        <%= chip("Dernier achat le #{short_date(last.created_at.to_date)}") %>
      <% end %>
    </div>
  </div>
  <div class="page-header__actions">
    <%= link_to edit_supplier_path(@supplier), class: "btn btn--outline" do %><%= icon("pencil") %> Modifier<% end %>
    <% if @supplier.active? %>
      <%= button_to "Désactiver", deactivate_supplier_path(@supplier), method: :post, class: "btn btn--outline",
                    form: { data: { turbo_confirm: "Désactiver #{@supplier.name} ?",
                                            confirm_detail: "Ses achats ne seront plus utilisés dans les prix, et une réactivation ne les rétablira pas automatiquement." } } %>
    <% else %>
      <%= button_to "Réactiver", activate_supplier_path(@supplier), method: :post, class: "btn btn--outline" %>
    <% end %>
  </div>
</header>

<div class="grid-auto" style="--grid-min: 180px">
  <div class="card kpi"><span class="kpi__label">Produits</span><span class="kpi__value"><%= @comparison.size %></span></div>
  <div class="card kpi"><span class="kpi__label">Achats enregistrés</span><span class="kpi__value"><%= all_purchases.size %></span></div>
  <div class="card kpi"><span class="kpi__label">Achats actifs</span><span class="kpi__value"><%= active_count %></span></div>
  <div class="card kpi"><span class="kpi__label">Plus utilisés</span><span class="kpi__value text-muted"><%= all_purchases.size - active_count %></span></div>
</div>

<% if @comparison.empty? %>
  <div class="card">
    <%= empty_state("Aucun achat chez ce fournisseur",
                    "Les achats se saisissent sur la fiche de chaque produit.") do %>
      <%= link_to "Voir les produits", products_path, class: "btn btn--outline" %>
    <% end %>
  </div>
<% else %>
  <section class="card" aria-labelledby="comparison-title">
    <div class="card__header">
      <div class="card__heading">
        <h2 id="comparison-title" class="card__title">Ses prix comparés à votre prix moyen, tous fournisseurs</h2>
        <p class="card__subtitle">
          <% if priced.any? %>
            Moins cher que la moyenne sur <%= cheaper.zero? ? "aucun produit" : pluralize(cheaper, "produit") %>, plus cher sur <%= dearer.zero? ? "aucun" : dearer %>.
          <% end %>
          Prix moyen pondéré de ses achats actifs, HT.
        </p>
      </div>
    </div>
    <div class="table-wrap">
      <table class="table" style="--table-min: 820px">
        <thead>
          <tr>
            <th scope="col">Produit</th>
            <th scope="col" class="num">Prix ici</th>
            <th scope="col" class="num">Moyenne générale</th>
            <th scope="col" class="num">Écart</th>
            <th scope="col" class="num">Achats actifs</th>
          </tr>
        </thead>
        <tbody>
          <% @comparison.each do |row| %>
            <% product = row[:product] %>
            <% unit = product_price_unit(product) %>
            <tr class="<%= "is-off" if row[:active_purchases].empty? %>">
              <td>
                <%= link_to product.name, product_path(product), class: "table__link" %>
                <div class="table__meta"><%= product_unit_label(product) %></div>
              </td>
              <td class="num text-strong"><%= row[:weighted_avg] ? eur(row[:weighted_avg], unit: unit) : chip("Plus utilisé", dot: :off) %></td>
              <td class="num text-secondary"><%= row[:global_avg] ? eur(row[:global_avg], unit: unit) : "—" %></td>
              <td class="num">
                <% if row[:delta_pct].nil? %>
                  <span class="text-muted">—</span>
                <% elsif row[:delta_pct].abs < 0.5 %>
                  <span class="text-muted">Dans la moyenne</span>
                <% elsif row[:delta_pct].positive? %>
                  <span class="text-warning text-medium">+<%= percent(row[:delta_pct], precision: 1) %> plus cher</span>
                <% else %>
                  <span class="text-success text-medium"><%= percent(row[:delta_pct].abs, precision: 1) %> moins cher</span>
                <% end %>
              </td>
              <td class="num text-secondary"><%= row[:active_purchases].size %> / <%= row[:purchases].size %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="card" aria-labelledby="purchases-detail-title">
    <div class="card__header">
      <div class="card__heading">
        <h2 id="purchases-detail-title" class="card__title">Détail des achats</h2>
        <p class="card__subtitle">Les achats actifs d’abord, du plus ancien au plus récent.</p>
      </div>
    </div>
    <div class="table-wrap">
      <table class="table" style="--table-min: 860px">
        <thead>
          <tr>
            <th scope="col">Produit</th>
            <th scope="col" class="num">Qté</th>
            <th scope="col">Unité</th>
            <th scope="col" class="num">Soit</th>
            <th scope="col" class="num">Prix HT</th>
            <th scope="col" class="num">Prix ramené</th>
            <th scope="col">Date</th>
            <th scope="col">Statut</th>
          </tr>
        </thead>
        <tbody>
          <% @comparison.each do |row| %>
            <% row[:purchases].each do |purchase| %>
              <tr class="<%= "is-off" unless purchase.active? %>">
                <td><%= link_to row[:product].name, product_path(row[:product]), class: "table__link" %></td>
                <td class="num"><%= fr_number(purchase.package_quantity, precision: 3, strip: true) %></td>
                <td><%= unit_label(purchase.package_unit) %></td>
                <td class="num text-secondary"><%= row[:product].base_unit == "l" ? "#{fr_number(purchase.package_quantity_kg, precision: 3, strip: true)} l" : weight_label(purchase.package_quantity_kg) %></td>
                <td class="num"><%= eur(purchase.package_price) %></td>
                <td class="num text-strong"><%= eur(purchase.price_per_kg, unit: product_price_unit(row[:product])) %></td>
                <td class="num text-secondary"><%= short_date(purchase.created_at.to_date) %></td>
                <td><%= purchase.active? ? chip("Actif", dot: :success) : chip("Inactif", dot: :off) %></td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>
