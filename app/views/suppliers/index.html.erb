<% content_for :title, "Fournisseurs" %>

<%= page_header("Fournisseurs",
                subtitle: "#{@pagy.count.zero? ? 'Aucun fournisseur actif' : pluralize(@pagy.count, 'fournisseur actif', plural: 'fournisseurs actifs')} · un fournisseur désactivé garde son historique") do %>
  <%= form_with model: Supplier.new, url: suppliers_path, class: "cluster cluster--sm" do |f| %>
    <label>
      <span class="sr-only">Nom du nouveau fournisseur</span>
      <%= f.text_field :name, class: "input", placeholder: "Nom du nouveau fournisseur", required: true,
                       style: "--input-width: 240px" %>
    </label>
    <%= f.button type: "submit", class: "btn btn--primary" do %><%= icon("plus-lg") %> Ajouter<% end %>
  <% end %>
<% end %>

<%= form_with url: suppliers_path, method: :get, class: "cluster cluster--sm" do |f| %>
  <label class="affix affix--prefix">
    <span class="sr-only">Rechercher un fournisseur</span>
    <span class="affix__prefix"><%= icon("search") %></span>
    <%= f.search_field :search, value: params[:search], placeholder: "Rechercher un fournisseur…", class: "input",
                       autocomplete: "off" %>
  </label>
  <%= f.submit "Rechercher", class: "btn btn--outline", name: nil %>
  <% if params[:search].present? %>
    <%= link_to "Effacer", suppliers_path, class: "btn btn--ghost" %>
  <% end %>
<% end %>

<% if @active_suppliers.empty? && @inactive_suppliers.empty? %>
  <div class="card">
    <% if params[:search].present? %>
      <%= empty_state("Aucun fournisseur trouvé pour « #{params[:search]} »") do %>
        <%= link_to "Voir tous les fournisseurs", suppliers_path, class: "btn btn--outline" %>
      <% end %>
    <% else %>
      <%= empty_state("Aucun fournisseur pour le moment",
                      "Ajoutez vos fournisseurs ci-dessus : vous les choisirez en saisissant vos achats.") %>
    <% end %>
  </div>
<% else %>
  <section class="card" aria-labelledby="active-suppliers-title">
    <div class="card__header">
      <div class="card__heading">
        <h2 id="active-suppliers-title" class="card__title">Actifs</h2>
        <p class="card__subtitle">Leurs achats actifs forment le prix moyen de vos produits.</p>
      </div>
    </div>
    <% if @active_suppliers.any? %>
      <%= render "suppliers/table", suppliers: @active_suppliers, stats: @stats, active: true %>
      <% if @pagy.pages > 1 %>
        <div class="pagination">
          <span class="text-body-sm text-muted num"><%= @pagy.from %>–<%= @pagy.to %> sur <%= @pagy.count %></span>
          <%== pagy_nav(@pagy) %>
        </div>
      <% end %>
    <% else %>
      <%= empty_state("Aucun fournisseur actif") %>
    <% end %>
  </section>

  <% if @inactive_suppliers.any? %>
    <section class="card" aria-labelledby="inactive-suppliers-title">
      <div class="card__header">
        <div class="card__heading">
          <h2 id="inactive-suppliers-title" class="card__title">Désactivés · <%= @inactive_suppliers.size %></h2>
          <p class="card__subtitle">Ils n’apparaissent plus dans les achats. « Supprimer » efface aussi leurs achats et recalcule les recettes concernées.</p>
        </div>
      </div>
      <%= render "suppliers/table", suppliers: @inactive_suppliers, stats: @stats, active: false %>
    </section>
  <% end %>
<% end %>
