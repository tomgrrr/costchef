<%= form_with model: supplier, class: "card" do |f| %>
  <% if supplier.errors.any? %>
    <div class="form-section">
      <%= notice_box(tone: :danger, css: "notice--top") do %>
        <ul class="notice__list">
          <% supplier.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
        </ul>
      <% end %>
    </div>
  <% end %>
  <div class="form-section">
    <div class="field">
      <%= f.label :name, "Nom du fournisseur" %>
      <%= f.text_field :name, class: "input", autofocus: true, placeholder: "Metro",
                       "aria-invalid": supplier.errors[:name].any? || nil %>
      <% if supplier.errors[:name].any? %><span class="field__error"><%= supplier.errors[:name].first %></span><% end %>
    </div>
  </div>
  <div class="form-actions">
    <%= link_to "Annuler", suppliers_path, class: "btn btn--outline" %>
    <%= f.button type: "submit", class: "btn btn--primary" do %>
      <%= supplier.persisted? ? "Enregistrer" : "Créer le fournisseur" %>
    <% end %>
  </div>
<% end %>
