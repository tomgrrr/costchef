<% content_for :title, "Produits" %>
<% zero_filter = params[:zero_price] == "1" %>
<% zero_count = current_user.products.where(avg_price_per_kg: 0).count %>

<%= page_header("Produits",
                subtitle: "Votre bibliothèque d’ingrédients · prix au kilo HT, moyenne pondérée de vos achats") do %>
  <%= link_to products_path(format: :csv, search: params[:search]), class: "btn btn--outline" do %>
    <%= icon("download") %> Exporter
  <% end %>
  <%= link_to new_product_path, class: "btn btn--primary" do %>
    <%= icon("plus-lg") %> Nouveau produit
  <% end %>
<% end %>

<div class="cluster cluster--between">
  <nav class="seg" aria-label="Filtrer les produits">
    <%= link_to products_path(search: params[:search], per_page: params[:per_page]), class: "seg__item",
                "aria-current": (zero_filter ? nil : "page") do %>
      Tous <span class="seg__count"><%= number_with_delimiter(current_user.products.count, delimiter: " ") %></span>
    <% end %>
    <%= link_to products_path(search: params[:search], per_page: params[:per_page], zero_price: "1"),
                class: "seg__item", "aria-current": (zero_filter ? "page" : nil) do %>
      <%= status_dot(:warning) %> Sans prix <span class="seg__count"><%= zero_count %></span>
    <% end %>
    <%= link_to standard_deviations_path, class: "seg__item" do %>
      <%= status_dot(:warning) %> Prix instables <%= icon("arrow-right") %>
    <% end %>
  </nav>

  <%= form_with url: products_path, method: :get, class: "cluster cluster--sm",
                data: { controller: "auto-submit" } do |f| %>
    <% if zero_filter %><%= hidden_field_tag :zero_price, "1" %><% end %>
    <label class="affix affix--prefix">
      <span class="sr-only">Rechercher un produit</span>
      <span class="affix__prefix"><%= icon("search") %></span>
      <%= f.search_field :search, value: params[:search], placeholder: "Rechercher un produit…",
                         class: "input", autocomplete: "off" %>
    </label>
    <label>
      <span class="sr-only">Produits par page</span>
      <%= f.select :per_page,
                   options_for_select([["20 par page", 20], ["50 par page", 50], ["100 par page", 100]],
                                      params[:per_page]&.to_i || 50),
                   {}, class: "input", data: { action: "change->auto-submit#submit" } %>
    </label>
    <%= f.submit "Rechercher", class: "btn btn--outline", name: nil %>
    <% if params[:search].present? %>
      <%= link_to "Effacer", products_path(zero_price: params[:zero_price]), class: "btn btn--ghost" %>
    <% end %>
  <% end %>
</div>

<div class="card">
  <% if @products.any? %>
    <div class="table-wrap">
      <table class="table" style="--table-min: 900px">
        <thead>
          <tr>
            <th scope="col">Produit</th>
            <th scope="col" class="num">Prix moyen pondéré</th>
            <th scope="col" class="num">Moyenne simple</th>
            <th scope="col" class="num">Variation</th>
            <th scope="col">Dernier achat</th>
            <th scope="col" class="num">Recettes</th>
            <th scope="col" class="table__actions"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% @products.each do |product| %>
            <%= render "products/product_card", product: product, usage_count: @usage_counts[product.id].to_i %>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="pagination">
      <span class="text-body-sm text-muted num"><%= @pagy.from %>–<%= @pagy.to %> sur <%= number_with_delimiter(@pagy.count, delimiter: " ") %></span>
      <% if @pagy.pages > 1 %><%== pagy_nav(@pagy) %><% end %>
    </div>
  <% elsif params[:search].present? %>
    <%= empty_state("Aucun produit trouvé pour « #{params[:search]} »", "Vérifiez l’orthographe ou cherchez un mot plus court.") do %>
      <%= link_to "Voir tous les produits", products_path, class: "btn btn--outline" %>
    <% end %>
  <% elsif zero_filter %>
    <%= empty_state("Tous vos produits ont un prix", "Aucun produit n’attend de prix d’achat.") do %>
      <%= link_to "Voir tous les produits", products_path, class: "btn btn--outline" %>
    <% end %>
  <% else %>
    <%= empty_state("Aucun produit pour le moment",
                    "Ajoutez vos ingrédients, puis leurs prix d’achat : CostChef calcule le prix au kilo.") do %>
      <%= link_to new_product_path, class: "btn btn--primary" do %><%= icon("plus-lg") %> Créer un produit<% end %>
    <% end %>
  <% end %>
</div>
