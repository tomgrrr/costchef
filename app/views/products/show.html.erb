<% content_for :title, @product.name %>

<%= breadcrumb(["Produits", products_path], @product.name) %>

<header class="page-header">
  <div class="page-header__text">
    <h1 class="text-display-lg"><%= @product.name %></h1>
    <div class="cluster cluster--xs">
      <%= chip(product_unit_label(@product)) %>
      <%= chip(@used_in.any? ? "Utilisé dans #{pluralize(@used_in.size, 'recette')}" : "Utilisé dans aucune recette") %>
    </div>
  </div>
  <div class="page-header__actions">
    <%= link_to edit_product_path(@product), class: "btn btn--outline" do %>
      <%= icon("pencil") %> Modifier
    <% end %>
    <% if @product.used_in_recipes? %>
      <span class="btn btn--outline" aria-disabled="true"
            title="Utilisé dans <%= pluralize(@product.recipes_count, 'recette') %> : retirez-le d’abord de ces recettes">
        <%= icon("trash") %> Supprimer
      </span>
    <% else %>
      <%= button_to product_path(@product), method: :delete, class: "btn btn--danger",
                    form: { data: { turbo_confirm: "Supprimer ce produit ?" } } do %>
        <%= icon("trash") %> Supprimer
      <% end %>
    <% end %>
    <a href="#achats" class="btn btn--primary"><%= icon("plus-lg") %> Ajouter un achat</a>
  </div>
</header>

<%# Everything that depends on purchases lives in this frame: Turbo Streams
    from ProductPurchasesController update it after each change. %>
<%= turbo_frame_tag "purchases_#{@product.id}", target: "_top" do %>
  <%= render "product_purchases/purchases_section",
             product: @product,
             purchases: @purchases,
             new_purchase: @new_purchase,
             suppliers: @suppliers %>
<% end %>
