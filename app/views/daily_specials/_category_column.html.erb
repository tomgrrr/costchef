<%# One category (meat, fish, side): average, add form, entries with inline edit.
    locals: category, entries, average, decor, title, placeholder %>
<section class="card card--pad stack stack--md" aria-labelledby="ds-<%= category %>-title">
  <div class="cluster cluster--between cluster--top">
    <div class="cluster cluster--sm">
      <span class="decor-dot <%= decor %>" aria-hidden="true"></span>
      <h2 id="ds-<%= category %>-title" class="card__title"><%= title %></h2>
    </div>
    <div class="stack stack--xs text-right">
      <span class="text-display-md num"><%= eur(average) %></span>
      <span class="text-body-sm text-muted">moyenne au kilo · <%= pluralize(entries.size, "plat") %></span>
    </div>
  </div>

  <%= form_with url: daily_specials_path, method: :post, scope: :daily_special, class: "stack stack--sm" do |f| %>
    <%= f.hidden_field :category, value: category, id: nil %>
    <div class="form-row">
      <div class="field">
        <%= f.label :item_name, "Plat", for: "ds_#{category}_name" %>
        <%= f.text_field :item_name, id: "ds_#{category}_name", placeholder: placeholder, class: "input", required: true %>
      </div>
    </div>
    <div class="form-row">
      <div class="field">
        <%= f.label :entry_date, "Date", for: "ds_#{category}_date" %>
        <%= f.date_field :entry_date, id: "ds_#{category}_date", value: Date.today, class: "input" %>
      </div>
      <div class="field field--sm">
        <%= f.label :cost_per_kg, "Coût / kg", for: "ds_#{category}_cost" %>
        <span class="affix">
          <%= f.number_field :cost_per_kg, id: "ds_#{category}_cost", step: 0.01, min: 0.01, placeholder: "0,00",
                             class: "input input--num", required: true %>
          <span class="affix__suffix" aria-hidden="true">€</span>
        </span>
      </div>
      <%= f.button type: "submit", class: "btn btn--primary", "aria-label": "Ajouter à #{title.downcase}" do %><%= icon("plus-lg") %><% end %>
    </div>
  <% end %>

  <% if entries.any? %>
    <div class="table-wrap">
      <table class="table table--compact" style="--table-min: 280px">
        <thead>
          <tr>
            <th scope="col">Date</th>
            <th scope="col">Plat</th>
            <th scope="col" class="num">€ / kg</th>
            <th scope="col" class="table__actions"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% entries.each do |entry| %>
            <% rows = "display-#{category}-#{entry.id},edit-#{category}-#{entry.id}" %>
            <tr id="display-<%= category %>-<%= entry.id %>">
              <td class="num text-secondary"><%= short_date(entry.entry_date) %></td>
              <td><%= entry.item_name %></td>
              <td class="num text-medium"><%= eur(entry.cost_per_kg) %></td>
              <td class="table__actions">
                <span class="row-actions">
                  <button type="button" class="icon-btn icon-btn--sm" title="Modifier" aria-label="Modifier <%= entry.item_name %>"
                          data-controller="toggle-edit" data-action="click->toggle-edit#toggle"
                          data-toggle-edit-target-param="<%= rows %>"><%= icon("pencil") %></button>
                  <%= button_to daily_special_path(entry), method: :delete, class: "icon-btn icon-btn--sm icon-btn--danger",
                                "aria-label": "Supprimer #{entry.item_name}", title: "Supprimer",
                                form: { data: { turbo_confirm: "Supprimer cette entrée ?" } } do %>
                    <%= icon("trash") %>
                  <% end %>
                </span>
              </td>
            </tr>
            <tr id="edit-<%= category %>-<%= entry.id %>" class="table__edit" hidden>
              <td colspan="4">
                <%= form_with url: daily_special_path(entry), method: :patch, scope: :daily_special, class: "stack stack--sm" do |f| %>
                  <%= f.hidden_field :category, value: entry.category, id: nil %>
                  <div class="form-row">
                    <div class="field">
                      <%= f.label :item_name, "Plat", for: "ds_edit_#{entry.id}_name" %>
                      <%= f.text_field :item_name, id: "ds_edit_#{entry.id}_name", value: entry.item_name, class: "input" %>
                    </div>
                  </div>
                  <div class="form-row">
                    <div class="field">
                      <%= f.label :entry_date, "Date", for: "ds_edit_#{entry.id}_date" %>
                      <%= f.date_field :entry_date, id: "ds_edit_#{entry.id}_date", value: entry.entry_date, class: "input" %>
                    </div>
                    <div class="field field--sm">
                      <%= f.label :cost_per_kg, "Coût / kg", for: "ds_edit_#{entry.id}_cost" %>
                      <%= f.number_field :cost_per_kg, id: "ds_edit_#{entry.id}_cost", value: entry.cost_per_kg,
                                         step: 0.01, min: 0.01, class: "input input--num" %>
                    </div>
                  </div>
                  <div class="cluster cluster--sm cluster--end">
                    <button type="button" class="btn btn--outline btn--sm" data-controller="toggle-edit"
                            data-action="click->toggle-edit#toggle" data-toggle-edit-target-param="<%= rows %>">Annuler</button>
                    <%= f.button type: "submit", class: "btn btn--primary btn--sm" do %>Enregistrer<% end %>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-body-sm text-muted">Aucun plat noté pour l’instant.</p>
  <% end %>
</section>
