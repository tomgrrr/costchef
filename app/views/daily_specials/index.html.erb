<% content_for :title, "Plats du jour" %>

<%= page_header("Plats du jour",
                subtitle: "Notez le coût de chaque plat du jour : CostChef en tire le coût moyen d’une assiette.") %>

<section class="stack stack--md" aria-labelledby="plates-title">
  <h2 id="plates-title" class="sr-only">Portionnement et prix d’une assiette</h2>
  <div class="grid-auto" style="--grid-min: 340px">
    <%= render "plate", title: "Assiette viande", main_label: "viande", decor: "decor-4",
               main_grams: (DailySpecialsController::MEAT_PORTION_KG * 1000).round,
               side_grams: (DailySpecialsController::MEAT_SIDE_PORTION_KG * 1000).round,
               main_average: @meat_average, side_average: @side_average,
               cost: @meat_portion_cost, price: @meat_portion_price %>
    <%= render "plate", title: "Assiette poisson", main_label: "poisson", decor: "decor-3",
               main_grams: (DailySpecialsController::FISH_PORTION_KG * 1000).round,
               side_grams: (DailySpecialsController::FISH_SIDE_PORTION_KG * 1000).round,
               main_average: @fish_average, side_average: @side_average,
               cost: @fish_portion_cost, price: @fish_portion_price %>
  </div>
  <p class="text-body-sm text-muted">
    Portionnement fixe · prix conseillé avec votre coefficient ×<%= fr_number(current_user.markup_coefficient) %>
  </p>
</section>

<div class="grid-auto" style="--grid-min: 320px">
  <%= render "category_column", category: "meat", entries: @meats, average: @meat_average,
             decor: "decor-4", title: "Viandes", placeholder: "Blanquette de veau" %>
  <%= render "category_column", category: "fish", entries: @fishes, average: @fish_average,
             decor: "decor-3", title: "Poissons", placeholder: "Dos de cabillaud" %>
  <%= render "category_column", category: "side", entries: @sides, average: @side_average,
             decor: "decor-1", title: "Accompagnements", placeholder: "Riz pilaf" %>
</div>
