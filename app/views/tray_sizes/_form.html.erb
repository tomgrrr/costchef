<%= form_with model: tray_size, class: "card" do |f| %>
  <% if tray_size.errors.any? %>
    <div class="form-section">
      <%= notice_box(tone: :danger, css: "notice--top") do %>
        <ul class="notice__list">
          <% tray_size.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
        </ul>
      <% end %>
    </div>
  <% end %>
  <div class="form-section">
    <div class="form-row">
      <div class="field">
        <%= f.label :name, "Nom de la barquette" %>
        <%= f.text_field :name, class: "input", required: true, autofocus: true, placeholder: "Barquette 1 kg",
                         "aria-invalid": tray_size.errors[:name].any? || nil %>
      </div>
      <div class="field field--md">
        <%= f.label :price, "Prix" %>
        <span class="affix">
          <%= f.number_field :price, class: "input input--num", min: 0, step: 0.01,
                             "aria-invalid": tray_size.errors[:price].any? || nil %>
          <span class="affix__suffix" aria-hidden="true">€</span>
        </span>
      </div>
    </div>
  </div>
  <div class="form-actions">
    <%= link_to "Annuler", tray_sizes_path, class: "btn btn--outline" %>
    <%= f.button type: "submit", class: "btn btn--primary" do %>
      <%= tray_size.persisted? ? "Enregistrer" : "Créer la barquette" %>
    <% end %>
  </div>
<% end %>
