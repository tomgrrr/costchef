<% content_for :title, "Créer votre compte" %>
<%= render layout: "shared/auth", locals: { title: "Créer votre compte", subtitle: "Vous avez été invité sur CostChef. Choisissez votre mot de passe pour commencer." } do %>
  <% if @user.errors.any? %>
    <%= notice_box(tone: :danger, css: "notice--top") do %>
      <ul class="notice__list">
        <% @user.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    <% end %>
  <% end %>

  <%= form_for @user, url: signup_path(token: @invitation.token), method: :post, html: { class: "stack stack--md" } do |f| %>
    <div class="field">
      <label for="invitation_email">Adresse email</label>
      <input type="email" id="invitation_email" class="input" value="<%= @invitation.email %>" readonly disabled>
      <span class="field__hint">L’adresse de votre invitation.</span>
    </div>

    <div class="field">
      <%= f.label :password, "Mot de passe" %>
      <%= f.password_field :password, autocomplete: "new-password", class: "input", autofocus: true,
                           "aria-invalid": @user.errors[:password].any? || nil %>
      <span class="field__hint">8 caractères minimum.</span>
    </div>

    <div class="field">
      <%= f.label :password_confirmation, "Confirmez le mot de passe" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input",
                           "aria-invalid": @user.errors[:password_confirmation].any? || nil %>
    </div>

    <%= f.button type: "submit", class: "btn btn--primary btn--block" do %>Créer mon compte<% end %>
  <% end %>

  <% if @invitation.expires_at %>
    <p class="text-body-sm text-muted">Invitation valable jusqu’au <%= short_date(@invitation.expires_at.to_date) %>.</p>
  <% end %>
<% end %>
