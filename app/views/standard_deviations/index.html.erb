<% content_for :title, "Prix instables" %>
<% max_cv = @product_entries.filter_map { |e| e[:cv] }.max.to_f %>
<% scale = [@threshold.to_f * 2.5, max_cv, 1].max %>
<% tick = (@threshold.to_f / scale * 100).round(1) %>

<%= page_header("Prix instables",
                subtitle: "Les produits dont vos prix d’achat varient le plus d’un achat à l’autre. Au-delà de votre seuil de #{percent(@threshold, precision: 2)}, le coût des recettes qui les utilisent devient moins fiable.") do %>
  <%= link_to "Modifier le seuil", tray_sizes_path(anchor: "seuil"), class: "btn btn--outline" %>
<% end %>

<%= form_with url: standard_deviations_path, method: :get, class: "cluster cluster--sm" do |f| %>
  <label class="affix affix--prefix" style="--input-width: 280px">
    <span class="sr-only">Rechercher un produit</span>
    <span class="affix__prefix"><%= icon("search") %></span>
    <%= f.search_field :search, value: params[:search], placeholder: "Rechercher un produit…", class: "input",
                       autocomplete: "off" %>
  </label>
  <%= f.submit "Rechercher", class: "btn btn--outline", name: nil %>
  <% if params[:search].present? %>
    <%= link_to "Effacer", standard_deviations_path, class: "btn btn--ghost" %>
  <% end %>
<% end %>

<div class="card">
  <% if @product_entries.empty? %>
    <% if params[:search].present? %>
      <%= empty_state("Aucun produit trouvé pour « #{params[:search]} »") do %>
        <%= link_to "Voir tous les produits", standard_deviations_path, class: "btn btn--outline" %>
      <% end %>
    <% else %>
      <%= empty_state("Aucun produit pour le moment", "La variation se mesure dès qu’un produit a deux achats actifs.") %>
    <% end %>
  <% else %>
    <div class="table-wrap">
      <table class="table" style="--table-min: 880px">
        <thead>
          <tr>
            <th scope="col">Produit</th>
            <th scope="col" class="num">Prix moyen pondéré</th>
            <th scope="col" class="num">Moyenne simple</th>
            <th scope="col">Variation · repère à <%= percent(@threshold, precision: 2) %></th>
            <th scope="col" class="num">Achats actifs</th>
          </tr>
        </thead>
        <tbody>
          <% group = nil %>
          <% @product_entries.each do |entry| %>
            <% product = entry[:product] %>
            <% cv = entry[:cv] %>
            <% current = cv.nil? ? :none : (cv > @threshold ? :above : :below) %>
            <% if current != group && current != :above %>
              <tr class="table__divider">
                <td colspan="5"><%= current == :below ? "Sous votre seuil de #{percent(@threshold, precision: 2)}" : "Moins de 2 achats actifs : variation non mesurable" %></td>
              </tr>
            <% end %>
            <% group = current %>
            <% active = loaded_active_purchases(product) %>
            <% unit = product_price_unit(product) %>
            <tr>
              <td><%= link_to product.name, product_path(product), class: "table__link" %></td>
              <td class="num text-medium"><%= product.avg_price_per_kg.to_d.positive? ? eur(product.avg_price_per_kg, unit: unit) : "—" %></td>
              <td class="num text-secondary"><%= active.any? ? eur(loaded_simple_average(product), unit: unit) : "—" %></td>
              <td>
                <% if cv %>
                  <span class="cluster cluster--sm cluster--nowrap">
                    <span class="meter meter--tick" style="--meter-width: 130px; --value: <%= [cv / scale * 100, 2].max.round(1) %>%; --tick: <%= tick %>%" aria-hidden="true">
                      <span class="meter__fill <%= current == :above ? "meter__fill--warning" : "meter__fill--muted" %>"></span>
                    </span>
                    <span class="num <%= current == :above ? "text-warning text-strong" : "text-secondary" %>">± <%= percent(cv, precision: 1) %></span>
                  </span>
                <% else %>
                  <span class="text-muted">N/A</span>
                <% end %>
              </td>
              <td class="num text-secondary"><%= entry[:active_count] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="pagination">
      <span class="text-body-sm text-muted num"><%= @pagy.from %>–<%= @pagy.to %> sur <%= @pagy.count %> · triés du plus instable au plus stable</span>
      <% if @pagy.pages > 1 %><%== pagy_nav(@pagy) %><% end %>
    </div>
  <% end %>
</div>
