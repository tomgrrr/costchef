<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<%# Emails need inline styles and literal colours: these mirror the CostChef tokens
    (--card #F5F6F7, --foreground #191A1D, --brand #5A2D4F). %>
<body style="margin: 0; padding: 0; background-color: #F5F6F7; font-family: 'Helvetica Neue', Arial, Helvetica, sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #F5F6F7; padding: 40px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="background-color: #FFFFFF; border: 1px solid #E6E7E9; border-radius: 14px; overflow: hidden;">
          <!-- Header -->
          <tr>
            <td style="padding: 28px 30px 0;">
              <p style="margin: 0; color: #5A2D4F; font-size: 20px; font-weight: bold; letter-spacing: -0.02em;">CostChef</p>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding: 40px 30px;">
              <h2 style="margin: 0 0 20px; color: #191A1D; font-size: 24px; font-weight: normal; letter-spacing: -0.02em;">Vous êtes invité à rejoindre CostChef</h2>

              <p style="margin: 0 0 15px; color: #4A4B4F; font-size: 16px; line-height: 1.5;">Bonjour,</p>

              <p style="margin: 0 0 15px; color: #4A4B4F; font-size: 16px; line-height: 1.5;">Vous avez été invité à créer un compte sur CostChef.</p>

              <p style="margin: 0 0 25px; color: #4A4B4F; font-size: 16px; line-height: 1.5;">Cliquez sur le lien ci-dessous pour créer votre compte :</p>

              <table role="presentation" cellpadding="0" cellspacing="0" style="margin: 0 0 25px;">
                <tr>
                  <td style="border-radius: 10px; background-color: #5A2D4F;">
                    <a href="<%= @signup_url %>" style="display: inline-block; padding: 14px 30px; color: #FFFFFF; text-decoration: none; font-size: 16px; font-weight: bold;">Créer mon compte</a>
                  </td>
                </tr>
              </table>

              <p style="margin: 0 0 15px; color: #4A4B4F; font-size: 14px; line-height: 1.5;">Ce lien expire dans 7 jours.</p>

              <p style="margin: 0; color: #6C6D70; font-size: 14px; line-height: 1.5;">Si vous n'êtes pas à l'origine de cette demande, ignorez cet email.</p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color: #F5F6F7; padding: 20px 30px; text-align: center; border-top: 1px solid #E6E7E9;">
              <p style="margin: 0; color: #6C6D70; font-size: 12px;">© <%= Date.current.year %> CostChef</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
