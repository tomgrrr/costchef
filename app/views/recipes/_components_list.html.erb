<%# Replaced by Turbo Stream after every component change (id must stay). %>
<div id="components_<%= recipe.id %>">
  <% components = recipe.recipe_components.select(&:persisted?).sort_by { |rc| -rc.line_cost.to_d } %>
  <% total_cost = recipe.cached_total_cost.to_d %>
  <% if components.any? %>
    <div class="table-wrap">
      <table class="table" style="--table-min: 780px">
        <thead>
          <tr>
            <th scope="col">Ingrédient</th>
            <th scope="col">Quantité</th>
            <th scope="col" class="num">Prix / kg</th>
            <th scope="col" class="num">Coût</th>
            <th scope="col" class="num">Part du coût</th>
            <th scope="col" class="table__actions"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% components.each do |rc| %>
            <% product = rc.product_component? ? rc.component : nil %>
            <% price_per_kg = product ? product.avg_price_per_kg.to_d : rc.component.cached_cost_per_kg.to_d %>
            <% share = total_cost.positive? ? (rc.line_cost.to_d / total_cost * 100) : 0 %>
            <% display_quantity = Units::Converter.to_display_unit(rc.quantity_kg.to_d, rc.quantity_unit, product: product) %>
            <tr>
              <td>
                <div class="cluster cluster--sm">
                  <% if product %>
                    <%= link_to rc.component.name, product_path(rc.component), class: "table__link" %>
                    <% if price_per_kg.zero? %><%= chip("Sans prix", tone: :warning, dot: :warning) %><% end %>
                  <% else %>
                    <%= link_to rc.component.name, recipe_path(rc.component, back: recipe_path(recipe)), class: "table__link" %>
                    <%= chip("Sous-recette", tone: :brand) %>
                  <% end %>
                </div>
              </td>
              <td>
                <%= form_with url: recipe_recipe_component_path(recipe, rc), method: :patch,
                              class: "cluster cluster--sm cluster--nowrap",
                              data: { turbo_stream: true, controller: "auto-submit" } do %>
                  <input type="hidden" name="recipe_component[quantity_unit]" value="<%= rc.quantity_unit %>">
                  <label class="sr-only" for="quantity_<%= rc.id %>">Quantité de <%= rc.component.name %> en <%= unit_label(rc.quantity_unit) %></label>
                  <input type="number" id="quantity_<%= rc.id %>"
                         name="recipe_component[quantity]"
                         value="<%= number_with_precision(display_quantity, precision: rc.quantity_unit == "piece" ? 1 : 3,
                                                          strip_insignificant_zeros: true, separator: ".", delimiter: "") %>"
                         step="0.001" min="0.001"
                         class="input input--num input--compact"
                         style="--input-width: 84px"
                         data-action="change->auto-submit#submit">
                  <span class="text-secondary"><%= unit_label(rc.quantity_unit) %></span>
                <% end %>
              </td>
              <td class="num text-secondary"><%= price_per_kg.positive? ? eur(price_per_kg) : "—" %></td>
              <td class="num text-medium"><%= eur(rc.line_cost) %></td>
              <td class="num">
                <span class="cluster cluster--sm cluster--nowrap cluster--end">
                  <span class="meter meter--sm" style="--meter-width: 56px; --value: <%= [share, 2].max.round(1) %>%" aria-hidden="true"><span class="meter__fill"></span></span>
                  <span><%= share.positive? && share < 1 ? "< 1 %" : percent(share) %></span>
                </span>
              </td>
              <td class="table__actions">
                <%= button_to recipe_recipe_component_path(recipe, rc), method: :delete,
                              class: "icon-btn icon-btn--danger", "aria-label": "Retirer #{rc.component.name}",
                              title: "Retirer de la recette",
                              form: { data: { turbo_confirm: "Retirer ce composant ?", turbo_stream: true } } do %>
                  <%= icon("trash") %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <td>Total avant cuisson · <%= pluralize(components.size, "ingrédient") %></td>
            <td><span class="num"><%= weight_label(recipe.cached_raw_weight) %></span></td>
            <td></td>
            <td class="num"><%= eur(recipe.cached_total_cost || 0) %></td>
            <td class="num">100 %</td>
            <td></td>
          </tr>
        </tfoot>
      </table>
    </div>
  <% else %>
    <%= empty_state("Aucun ingrédient pour le moment",
                    "Cherchez un produit ou une sous-recette ci-dessus, indiquez la quantité : le coût se calcule tout seul.") %>
  <% end %>
</div>
