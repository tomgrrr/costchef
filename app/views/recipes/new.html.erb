<% subrecipe = @recipe.subrecipe? %>
<% content_for :title, subrecipe ? "Nouvelle sous-recette" : "Nouvelle recette" %>
<% content_for :content_class, "app__content--narrow" %>

<%= breadcrumb([subrecipe ? "Sous-recettes" : "Recettes", recipes_path(tab: subrecipe ? "subrecipes" : "recipes")],
               subrecipe ? "Nouvelle sous-recette" : "Nouvelle recette") %>
<%= page_header(subrecipe ? "Nouvelle sous-recette" : "Nouvelle recette",
                subtitle: "Commencez par l’essentiel. Vous ajouterez les ingrédients juste après.") %>
<%= render "form", recipe: @recipe %>
