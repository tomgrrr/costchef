<% content_for :title, @recipe.name %>
<% list_path = recipes_path(tab: @recipe.subrecipe? ? "subrecipes" : "recipes") %>
<% back_label = params[:back].present? ? "Retour" : (@recipe.subrecipe? ? "Sous-recettes" : "Recettes") %>

<%= breadcrumb([back_label, safe_back_path(params[:back], list_path)], @recipe.name) %>

<header class="page-header">
  <div class="page-header__text">
    <h1 class="text-display-lg"><%= @recipe.name %></h1>
    <div class="cluster cluster--xs">
      <% if @recipe.subrecipe? %>
        <%= chip("Sous-recette", tone: :brand) %>
      <% else %>
        <%= chip("Recette finale") %>
        <% if @recipe.sold_by_unit? && @recipe.unit_reference_weight_kg.present? %>
          <%= chip("Vendue à l’unité · #{weight_label(@recipe.unit_reference_weight_kg)}") %>
        <% end %>
        <% if @recipe.has_tray? %>
          <%= @recipe.tray_size ? chip(@recipe.tray_size.name) : chip("Barquette sans taille", tone: :warning, dot: :warning) %>
        <% end %>
      <% end %>
      <%= chip("Mise à jour le #{short_date(@recipe.updated_at.to_date)}") %>
    </div>
  </div>
  <div class="page-header__actions">
    <%= button_to duplicate_recipe_path(@recipe), method: :post, class: "btn btn--outline",
                  form: { data: { turbo_confirm: "Dupliquer cette recette ?" } } do %>
      <%= icon("copy") %> Dupliquer
    <% end %>
    <%= render "recipes/convert_button", recipe: @recipe %>
    <details class="menu" data-controller="menu">
      <summary class="btn btn--outline"><%= icon("download") %> Exporter <%= icon("chevron-down") %></summary>
      <div class="menu__panel">
        <%= link_to export_excel_recipe_path(@recipe), class: "menu__item" do %>
          <%= icon("file-earmark-excel") %> <span>Excel sans coûts <span class="menu__hint">La composition seule</span></span>
        <% end %>
        <%= link_to export_excel_recipe_path(@recipe, detailed: 1), class: "menu__item" do %>
          <%= icon("file-earmark-excel") %> <span>Excel avec coûts <span class="menu__hint">Composition, coûts et prix</span></span>
        <% end %>
      </div>
    </details>
    <%= link_to edit_recipe_path(@recipe, back: params[:back]), class: "btn btn--outline" do %>
      <%= icon("pencil") %> Modifier
    <% end %>
  </div>
</header>

<div class="split">
  <div class="split__main">
    <section class="card" aria-labelledby="composition-title">
      <div class="card__header">
        <div class="card__heading">
          <h2 id="composition-title" class="card__title">Composition</h2>
          <p class="card__subtitle">Les ingrédients sont classés du plus cher au moins cher.</p>
        </div>
      </div>
      <div class="card__body">
        <%= render "recipe_components/form",
                   recipe: @recipe,
                   component: RecipeComponent.new,
                   available_products: current_user.products.order(:name),
                   available_subrecipes: current_user.recipes.usable_as_subrecipe
                                                     .where.not(id: @recipe.id).order(:name) %>
      </div>
      <%= render "recipes/components_list", recipe: @recipe %>
    </section>

    <%= render "recipes/cooking_loss_form", recipe: @recipe %>

    <%= render "recipes/cost_breakdown", recipe: @recipe %>

    <% if @recipe.description.present? %>
      <section class="card card--pad stack stack--sm" aria-labelledby="description-title">
        <h2 id="description-title" class="card__title">Description</h2>
        <%= simple_format(@recipe.description, class: "text-secondary") %>
      </section>
    <% end %>
  </div>

  <aside class="split__aside" aria-label="Prix de vente">
    <%= render "recipes/recipe_summary", recipe: @recipe %>
  </aside>
</div>
