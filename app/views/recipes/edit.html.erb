<% content_for :title, "Modifier #{@recipe.name}" %>
<% content_for :content_class, "app__content--narrow" %>

<%= breadcrumb([@recipe.subrecipe? ? "Sous-recettes" : "Recettes", safe_back_path(params[:back], recipes_path)],
               [@recipe.name, recipe_path(@recipe, back: params[:back])], "Modifier") %>
<%= page_header("Modifier #{@recipe.name}",
                subtitle: "Chaque changement recalcule le coût et le prix de vente.") %>
<%= render "form", recipe: @recipe %>
