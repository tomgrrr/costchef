<% content_for :title, "Prix de vente" %>

<%= page_header("Recettes",
                subtitle: "Prix de vente calculés avec votre coefficient ×#{fr_number(current_user.markup_coefficient)}") do %>
  <details class="menu" data-controller="menu">
    <summary class="btn btn--outline"><%= icon("download") %> Exporter les prix <%= icon("chevron-down") %></summary>
    <div class="menu__panel">
      <%= link_to tarifs_recipes_path(format: :csv), class: "menu__item" do %>
        <%= icon("filetype-csv") %> <span>CSV <span class="menu__hint">Prix HT, TTC et à l’unité</span></span>
      <% end %>
      <%= link_to export_tarifs_excel_recipes_path, class: "menu__item" do %>
        <%= icon("file-earmark-excel") %> <span>Excel <span class="menu__hint">Prix HT, TTC et à l’unité</span></span>
      <% end %>
    </div>
  </details>
  <%= link_to new_recipe_path, class: "btn btn--primary" do %>
    <%= icon("plus-lg") %> Nouvelle recette
  <% end %>
<% end %>

<%= render "recipes/list_toolbar", tab: "recipes", view: :prices %>

<div class="card">
  <% if @recipes.any? %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Recette</th>
            <th scope="col" class="num">Coût / kg</th>
            <th scope="col" class="num">Prix HT / kg</th>
            <th scope="col" class="num">Prix TTC / kg</th>
            <th scope="col" class="num">Prix à l’unité HT</th>
            <th scope="col">Barquette</th>
          </tr>
        </thead>
        <tbody>
          <% @recipes.each do |recipe| %>
            <tr>
              <td><%= link_to recipe.name, recipe_path(recipe, back: request.fullpath), class: "table__link" %></td>
              <td class="num">
                <% if recipe.cached_cost_per_kg.to_d.positive? %>
                  <%= eur(recipe.cached_cost_per_kg) %>
                <% else %>
                  <%= chip("Non calculé", tone: :warning) %>
                <% end %>
              </td>
              <td class="num text-strong"><%= eur(recipe.suggested_selling_price) %></td>
              <td class="num"><%= eur(recipe.pvc_ttc) %></td>
              <td class="num">
                <% if recipe.unit_selling_price.present? %>
                  <%= eur(recipe.unit_selling_price) %>
                  <span class="text-muted">· <%= weight_label(recipe.unit_reference_weight_kg) %></span>
                <% else %>
                  —
                <% end %>
              </td>
              <td class="text-secondary">
                <% if recipe.has_tray? && recipe.tray_size %>
                  <%= recipe.tray_size.name %> · <span class="num"><%= eur(recipe.tray_size.price) %></span>
                <% elsif recipe.has_tray? %>
                  <%= chip("Taille manquante", tone: :warning, dot: :warning) %>
                <% else %>
                  —
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="pagination">
      <span class="text-body-sm text-muted"><%= pluralize(@recipes.size, "recette") %> · TVA appliquée selon chaque recette</span>
    </div>
  <% else %>
    <%= empty_state("Aucune recette pour le moment",
                    "Les prix de vente apparaissent ici dès qu’une recette a des ingrédients.") do %>
      <%= link_to new_recipe_path, class: "btn btn--primary" do %><%= icon("plus-lg") %> Créer une recette<% end %>
    <% end %>
  <% end %>
</div>
