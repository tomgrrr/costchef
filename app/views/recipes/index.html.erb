<% subrecipes = @tab == "subrecipes" %>
<% content_for :title, subrecipes ? "Sous-recettes" : "Recettes" %>

<%= page_header(subrecipes ? "Sous-recettes" : "Recettes",
                subtitle: (subrecipes ? "Sauces, pâtes, purées… utilisées dans d’autres recettes" :
                  "Coût de revient au kilo de chaque recette, après cuisson")) do %>
  <details class="menu" data-controller="menu">
    <summary class="btn btn--outline"><%= icon("download") %> Exporter <%= icon("chevron-down") %></summary>
    <div class="menu__panel">
      <%= link_to recipes_path(format: :csv, tab: @tab, search: params[:search]), class: "menu__item" do %>
        <%= icon("filetype-csv") %> <span>CSV <span class="menu__hint">Cette liste, coûts au kilo</span></span>
      <% end %>
      <%= link_to export_all_excel_recipes_path(tab: @tab), class: "menu__item" do %>
        <%= icon("file-earmark-excel") %> <span>Excel sans coûts <span class="menu__hint">Compositions seulement</span></span>
      <% end %>
      <%= link_to export_all_excel_recipes_path(tab: @tab, detailed: 1), class: "menu__item" do %>
        <%= icon("file-earmark-excel") %> <span>Excel avec coûts <span class="menu__hint">Compositions et coûts</span></span>
      <% end %>
      <%= link_to export_full_excel_recipes_path, class: "menu__item" do %>
        <%= icon("file-earmark-excel") %> <span>Export complet <span class="menu__hint">Toutes les recettes et sous-recettes</span></span>
      <% end %>
    </div>
  </details>
  <% if subrecipes %>
    <%= link_to new_recipe_path(type: "subrecipe"), class: "btn btn--primary" do %>
      <%= icon("plus-lg") %> Nouvelle sous-recette
    <% end %>
  <% else %>
    <%= link_to new_recipe_path, class: "btn btn--primary" do %>
      <%= icon("plus-lg") %> Nouvelle recette
    <% end %>
  <% end %>
<% end %>

<%= render "recipes/list_toolbar", tab: @tab, view: :costs %>

<div class="card">
  <% if @recipes.any? %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th scope="col"><%= subrecipes ? "Sous-recette" : "Recette" %></th>
            <th scope="col" class="num">Coût / kg</th>
            <th scope="col" class="num">Poids final</th>
            <th scope="col" class="num">Perte à la cuisson</th>
            <% unless subrecipes %><th scope="col">Vendue</th><% end %>
            <th scope="col" class="table__actions"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% @recipes.each do |recipe| %>
            <% show_path = recipe_path(recipe, back: request.fullpath) %>
            <% zero_count = recipe.zero_price_products_count %>
            <tr>
              <td>
                <%= link_to recipe.name, show_path, class: "table__link" %>
                <div class="table__meta">
                  <span><%= pluralize(recipe.recipe_components.size, "ingrédient") %><%= " · #{recipe.tray_size.name}" if recipe.has_tray? && recipe.tray_size %></span>
                  <% if recipe.has_tray? && recipe.tray_size.nil? %>
                    <%= chip("Barquette sans taille", tone: :warning, dot: :warning) %>
                  <% end %>
                  <% if zero_count.positive? %>
                    <%= chip(dot: :warning, tone: :warning) do %><%= zero_count %> produit<%= "s" if zero_count > 1 %> sans prix<% end %>
                  <% end %>
                </div>
              </td>
              <td class="num">
                <% if recipe.cached_cost_per_kg.to_d.positive? %>
                  <%= eur(recipe.cached_cost_per_kg) %>
                <% else %>
                  <%= chip("Non calculé", tone: :warning) %>
                <% end %>
              </td>
              <td class="num"><%= weight_label(recipe.cached_total_weight) %></td>
              <td class="num"><%= percent(recipe.cooking_loss_percentage || 0, precision: 2) %></td>
              <% unless subrecipes %>
                <td class="text-secondary nowrap">
                  <%= recipe.sold_by_unit? ? "À l’unité · #{weight_label(recipe.unit_reference_weight_kg)}" : "Au kilo" %>
                </td>
              <% end %>
              <td class="table__actions">
                <details class="menu" data-controller="menu">
                  <summary class="icon-btn" aria-label="Actions pour <%= recipe.name %>"><%= icon("three-dots") %></summary>
                  <div class="menu__panel">
                    <%= link_to show_path, class: "menu__item" do %><%= icon("eye") %> Ouvrir<% end %>
                    <%= link_to edit_recipe_path(recipe, back: request.fullpath), class: "menu__item" do %><%= icon("pencil") %> Modifier<% end %>
                    <%= button_to duplicate_recipe_path(recipe), method: :post, class: "menu__item",
                                  form: { data: { turbo_confirm: "Dupliquer cette recette ?" } } do %>
                      <%= icon("copy") %> Dupliquer
                    <% end %>
                    <%= button_to recipe_path(recipe), method: :delete, class: "menu__item",
                                  form: { data: { turbo_confirm: "Supprimer cette recette ?" } } do %>
                      <%= icon("trash") %> Supprimer
                    <% end %>
                  </div>
                </details>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="pagination">
      <span class="text-body-sm text-muted num"><%= @pagy.from %>–<%= @pagy.to %> sur <%= @pagy.count %></span>
      <% if @pagy.pages > 1 %><%== pagy_nav(@pagy) %><% end %>
    </div>
  <% elsif params[:search].present? %>
    <%= empty_state("Aucune recette trouvée pour « #{params[:search]} »", "Vérifiez l’orthographe ou cherchez un mot plus court.") do %>
      <%= link_to "Voir toutes les recettes", recipes_path(tab: @tab), class: "btn btn--outline" %>
    <% end %>
  <% else %>
    <%= empty_state(subrecipes ? "Aucune sous-recette pour le moment" : "Aucune recette pour le moment",
                    "Créez une recette, ajoutez ses ingrédients : le coût et le prix de vente se calculent tout seuls.") do %>
      <%= link_to(subrecipes ? new_recipe_path(type: "subrecipe") : new_recipe_path, class: "btn btn--primary") do %>
        <%= icon("plus-lg") %> <%= subrecipes ? "Créer une sous-recette" : "Créer une recette" %>
      <% end %>
    <% end %>
  <% end %>
</div>
