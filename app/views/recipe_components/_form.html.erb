<%# Add-ingredient form. Replaced by Turbo Stream after each add (id must stay). %>
<% products_json = available_products.map { |p| { id: p.id, name: p.name } }.to_json %>
<% subrecipes_json = available_subrecipes.map { |r| { id: r.id, name: r.name } }.to_json %>

<div id="component_form_<%= recipe.id %>"
     class="stack stack--sm"
     data-controller="unified-search"
     data-unified-search-products-value="<%= products_json %>"
     data-unified-search-subrecipes-value="<%= subrecipes_json %>">

  <% if component.errors.any? %>
    <%= notice_box(tone: :danger, css: "notice--top") do %>
      <ul class="notice__list">
        <% component.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    <% end %>
  <% end %>

  <%= form_with url: recipe_recipe_components_path(recipe), scope: :recipe_component,
                data: { turbo_stream: true }, class: "stack stack--sm" do |f| %>
    <input type="hidden" name="recipe_component[component_id]" data-unified-search-target="componentId">
    <input type="hidden" name="recipe_component[component_type]" data-unified-search-target="componentType">

    <div class="form-row">
      <div class="field picker">
        <label for="component_search_<%= recipe.id %>">Ajouter un ingrédient</label>
        <span class="affix affix--prefix">
          <span class="affix__prefix"><%= icon("search") %></span>
          <input type="text" id="component_search_<%= recipe.id %>" class="input" autocomplete="off"
                 <%= "autofocus" if local_assigns[:autofocus] %>
                 placeholder="Produit ou sous-recette : crème, purée…"
                 data-unified-search-target="searchInput"
                 data-action="input->unified-search#search click->unified-search#open keydown.esc->unified-search#close">
        </span>
        <div class="search-results" hidden data-unified-search-target="resultsList"></div>
      </div>
      <div class="field field--sm">
        <%= f.label :quantity, "Quantité" %>
        <%= f.number_field :quantity, step: "0.001", min: "0.001", placeholder: "0,250",
                           class: "input input--num" %>
      </div>
      <div class="field field--xs">
        <%= f.label :quantity_unit, "Unité" %>
        <%= f.select :quantity_unit, unit_options(Units::VALID_UNITS), { include_blank: false }, class: "input" %>
      </div>
      <%= f.button type: "submit", class: "btn btn--primary", disabled: true,
                   data: { unified_search_target: "submitBtn" } do %>
        <%= icon("plus-lg") %> Ajouter
      <% end %>
    </div>

    <p class="picker-selection">
      <span>Sélection :</span>
      <strong data-unified-search-target="selectedDisplay">Aucune sélection</strong>
      <button type="button" class="btn btn--ghost btn--sm" data-action="click->unified-search#clear">Effacer</button>
    </p>
  <% end %>
</div>
